{
  "name": "microvm-workshop",
  "version": "1.0.0",
  "private": true,
  "description": "Workshop: Packaging Codex App Server in microVMs with multi-agent browser-use fan-out",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter fixtures dev",
    "build": "pnpm run -r build",
    "test": "vitest run",
    "typecheck": "pnpm run -r typecheck",
    "bootstrap": "./scripts/bootstrap.sh",
    "demo": "./scripts/run-demo.sh",
    "reset": "./scripts/reset-fixtures.sh",
    "fixtures": "pnpm --filter fixtures dev"
  },
  "dependencies": {
    "yaml": "^2.3.4"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0",
    "tsx": "^4.7.0",
    "vitest": "^1.2.0",
    "eslint": "^8.55.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@8.15.0"
}
